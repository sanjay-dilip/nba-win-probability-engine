# Byte-compiled / cache
__pycache__/
*.py[cod]

# Virtual environments
.venv/
venv/

# Environment variables
.env

# OS files
.DS_Store

# Jupyter
.ipynb_checkpoints/

# Generated data (kept out of version control)
data/raw/*
data/processed/*
data/playoffs/*
data/logs/*

# Deploy-safe public dashboard files
data/deploy/*
!data/deploy/
!data/deploy/finals_live_predictions.csv
!data/deploy/pregame_demo_predictions.csv
!data/deploy/live_demo_predictions.csv

# Deploy-safe public report files
outputs/reports/*
!outputs/reports/
!outputs/reports/.gitkeep
!outputs/reports/finals_*.csv
!outputs/reports/nba_finals_case_study_summary.csv
!outputs/reports/playoff_coverage_report.csv
!outputs/reports/project_qa_summary.csv
!outputs/reports/data_freshness_summary.csv
!outputs/reports/model_performance_public_summary.csv

# Trained model binaries
models/*.pkl

# Internal handoff file (exclude before public repo cleanup)
CONTEXT.md

# --- Explicitly keep these tracked ---
!data/sample/
!data/sample/*
!data/manual/
!models/sample/
!docs/
!assets/

# Keep empty tracked folders
!**/.gitkeep
